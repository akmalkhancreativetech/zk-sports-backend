# Copy to `.env` on the server, then fill in every CHANGE-ME.
#
#   cp .env.docker.example .env
#
# This one file is read twice: by Docker Compose for the ${...} values in
# compose.yaml, and by the app container as Laravel's environment. It is
# gitignored — nothing here ever reaches the repo or an image.
#
# Replace zk-server.tail1234.ts.net with your machine's real Tailscale name:
#   tailscale status --self --json | grep DNSName

APP_NAME="ZK Sports"
APP_ENV=production
APP_DEBUG=false

# Generate once, on the server:
#   docker compose run --rm app php artisan key:generate --show
# The app container refuses to start while this is empty.
APP_KEY=

# MUST include :8443 — every image URL sent to the public site is built from
# this, so a wrong value means broken images and a broken login redirect.
APP_URL=https://zk-server.tail1234.ts.net:8443

LOG_LEVEL=error
LOG_CHANNEL=stderr

# --- Database -----------------------------------------------------------
# DB_HOST is set to `db` by compose and cannot be overridden here.
DB_CONNECTION=mysql
DB_DATABASE=zk_sports
DB_USERNAME=zk_sports
DB_PASSWORD=CHANGE-ME-strong-password
# Used only by the db container's healthcheck and for admin access.
DB_ROOT_PASSWORD=CHANGE-ME-different-strong-password

# --- Sessions and Sanctum ----------------------------------------------
# Funnel serves the site on :443 and this app on :8443 of the SAME hostname,
# and cookies ignore ports — so host-only cookies are correct and no subdomain
# split is needed. See docs/frontend-plan.md §1.2.
SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

FRONTEND_URL=https://zk-server.tail1234.ts.net
SANCTUM_STATEFUL_DOMAINS=zk-server.tail1234.ts.net

CACHE_STORE=database
FILESYSTEM_DISK=public

# Nothing is queued yet, so jobs run inline and there is no worker container.
QUEUE_CONNECTION=sync

# Password resets and order notifications go to the container log until SMTP
# is configured.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"

# --- Nginx --------------------------------------------------------------
# What the web container tells Laravel the request host was. Include the port.
PUBLIC_API_ORIGIN=zk-server.tail1234.ts.net:8443

# --- Public site (BUILD-TIME values) ------------------------------------
# These are inlined into the browser bundle when the `site` image is built.
# Changing one means `docker compose up -d --build site`, NOT a restart.
NEXT_PUBLIC_API_URL=https://zk-server.tail1234.ts.net:8443
NEXT_PUBLIC_SITE_URL=https://zk-server.tail1234.ts.net

# A .ts.net name resolves to a private 100.x address on the server itself, and
# Next 16's image optimizer refuses private hosts unless told otherwise.
IMAGES_ALLOW_LOCAL_IP=true
